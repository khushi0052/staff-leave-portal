# Supabase connection for the React frontend
# These values are exposed to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase connection for the local seed script only
# NEVER expose the service role key in React or Vercel frontend variables.
SUPABASE_URL=
SERVICE_ROLE_KEY=

# PostgreSQL connection for database integration tests
# Use a local test database, never production.
DB_URL=